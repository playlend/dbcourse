# Milestone 4 end-to-end CRUD suite.
# Course conventions exercised here: SQL three-valued logic in WHERE,
# NULLs ordering last in ORDER BY (either direction), Postgres-style
# affected counts.

statement ok
CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INTEGER, active BOOLEAN)

statement ok
INSERT INTO users (id, name, age, active) VALUES (1, 'ada', 36, true), (2, 'bob', 29, false), (3, 'eve', NULL, true), (4, 'dan', 41, NULL)

# pure expression evaluation (Values + Projection): precedence check
query I
SELECT 1 + 2 * 3
----
7

query IT rowsort
SELECT id, name FROM users
----
1 ada
2 bob
3 eve
4 dan

# eve's NULL age fails age > 30 (NULL is not true)
query I rowsort
SELECT id FROM users WHERE age > 30
----
1
4

query I
SELECT id FROM users WHERE age IS NULL
----
3

# bare boolean column as predicate; dan's NULL active drops him
query T
SELECT name FROM users WHERE active ORDER BY id
----
ada
eve

# NULLs order last, even under DESC
query TI
SELECT name, age FROM users ORDER BY age DESC
----
dan 41
ada 36
bob 29
eve NULL

query T
SELECT name FROM users ORDER BY id LIMIT 2
----
ada
bob

statement ok
UPDATE users SET age = 30 WHERE name = 'bob'

query I
SELECT age FROM users WHERE name = 'bob'
----
30

# self-referential update: every qualifying row bumped exactly once
statement ok
UPDATE users SET age = age + 1 WHERE age > 30

query I rowsort
SELECT age FROM users WHERE age > 30
----
37
42

statement ok
DELETE FROM users WHERE active = false

query I rowsort
SELECT id FROM users
----
1
3
4

# = NULL is never true — this returns no rows (that's what IS NULL is for)
query I
SELECT id FROM users WHERE age = NULL
----

query IT rowsort
SELECT id, name FROM users WHERE name = 'eve' OR age = 42
----
3 eve
4 dan

# binder errors are errors, not panics
statement error
SELECT nope FROM users

statement error
INSERT INTO users (id, name) VALUES (5)
